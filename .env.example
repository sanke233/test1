PORT=3001
JWT_SECRET=degistir_bu_anahtari_guvenli_olacak
JWT_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:5173

# Cloudflare D1 (Node.js + D1 HTTP API)
# İki seçenekten biri:
# SECENEK A: Cloudflare REST API (token ile)
CF_API_TOKEN=your_cloudflare_api_token
CF_ACCOUNT_ID=your_account_id
CF_D1_DATABASE_ID=your_d1_database_id
# SECENEK B: Kendi D1 proxy Worker'ın URL'i (önerilen, daha hızlı)
D1_HTTP_URL=
